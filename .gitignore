# ============================================================
# 1. LOCAL CONFIGURATION
# ============================================================
# Local secrets and environment variables
# I exclude .env because it can contain passwords and API keys.
# Concept: a filename pattern matches files with this name.
.env

# ============================================================
# 2. DEVELOPMENT ENVIRONMENT
# ============================================================
# Python virtual environment
# I exclude installed packages from my local Python environment.
# Dependencies can be installed using requirements.txt.
# Concept: a trailing slash matches directories.
.venv/

# ============================================================
# 3. GENERATED PYTHON FILES
# ============================================================
# Python cache files
# Python generates these files when importing modules.
# They are generated output, so I do not need to commit them.
__pycache__/

# Concept: * is a wildcard matching any filename ending in .pyc.
*.pyc

# ============================================================
# 4. OPERATING SYSTEM FILES
# ============================================================
# macOS system files
# Finder creates this metadata file; my application does not need it.
.DS_Store

# ============================================================
# 5. GENERATED DJANGO ASSETS
# ============================================================
# Files generated by Django collectstatic
# build.sh runs collectstatic, which gathers static assets.
# This rule ignores that output when it is stored in staticfiles/.
staticfiles/